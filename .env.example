# Скопируй в .env:  cp .env.example .env
# Без .env проект тоже запускается: без ключа и модели включается mock-режим.

# Предметная область: имя модуля из backend/agent/core/domains/ (без .py)
AGENT_DOMAIN=contractors

# --- Провайдер модели ---------------------------------------------------
# Любой OpenAI-совместимый endpoint. Проверить всё разом: python scripts/dev.py llm
#
# OpenAI ($50 кредитов):
#   OPENAI_BASE_URL=            (пусто = api.openai.com)
#   OPENAI_MODEL=gpt-5.4-mini   проверено: худший сценарий 6.5 с против 11 с у gpt-5.5
#                               при одинаковом прогоне. Порог ТЗ — 10 секунд.
#
# Своя модель на GPU (NVIDIA Brev: кредиты там на аренду GPU, а не на API).
# Поднимаете launchable с NIM или vLLM — он отдаёт OpenAI-совместимый /v1:
#   OPENAI_BASE_URL=http://<адрес-инстанса>:8000/v1
#   OPENAI_MODEL=               id модели, который отдаёт сам инстанс
#   OPENAI_API_KEY=local        ВАЖНО: пустой ключ включает mock-режим,
#                               поэтому для self-hosted ставьте любую непустую строку
#
# Инстанс Brev тарифицируется по времени работы, а не по токенам:
# не забудьте остановить его, иначе $50 сгорят за ночь.
#
# Модель обязана поддерживать tool calling, иначе агент не заработает.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 1 = заскриптованная "модель" без сети (разработка интерфейса, запасное демо,
# проверка решения без наших ключей). Включается автоматически, если пуст
# OPENAI_API_KEY или OPENAI_MODEL.
LLM_MOCK=1

# Предел вызовов модели за один запуск. Прямо влияет на расход кредитов.
AGENT_MAX_STEPS=12

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
NEXT_PUBLIC_API_URL=http://localhost:8000
